---
import MainLayout from "@/layouts/main.astro";
import TechLogos from "@/components/TechLogos.astro";

const services = [
  {
    num: "01",
    title: "Production Readiness Audits",
    body: "Review your prototype, MVP, codebase, stack, infrastructure, and launch risks. Get a clear picture of what is solid, what is fragile, and what needs to be fixed before launch.",
  },
  {
    num: "02",
    title: "Prototype Rescue & Refactoring",
    body: "Clean up AI-generated or rushed code, improve maintainability, reduce technical risk, and prepare the system for real-world usage.",
  },
  {
    num: "03",
    title: "Web Apps, Platforms & APIs",
    body: "Build or harden scalable systems across frontend, backend, databases, integrations, and application architecture.",
  },
  {
    num: "04",
    title: "Performance-Focused Websites",
    body: "Develop high-performance, SEO-friendly websites and content platforms built to be fast, maintainable, and easy to evolve.",
  },
  {
    num: "05",
    title: "Infrastructure, Deployment & CI/CD",
    body: "Set up repositories, environments, automation, Docker workflows, cloud deployment, monitoring, and launch processes.",
  },
  {
    num: "06",
    title: "Technical Partnership for Agencies",
    body: "Work as a trusted implementation partner for design and marketing agencies that need senior technical depth behind the scenes.",
  },
];

const valuePoints = [
  {
    title: "Direct senior execution",
    body: "You work directly with the person reviewing architecture, writing code, and solving technical problems.",
  },
  {
    title: "AI speed with engineering rigor",
    body: "AI helps move faster. Experience helps avoid fragile decisions, technical debt, and launch mistakes.",
  },
  {
    title: "Built for real-world delivery",
    body: "The goal is not a flashy demo. The goal is a system that can actually be launched, maintained, and scaled.",
  },
];

const audience = [
  {
    label: "Founders & startups",
    body: "You have a prototype, MVP, or AI-generated build, and you need real engineering support to launch with confidence.",
  },
  {
    label: "Businesses",
    body: "You need a scalable website, platform, API, portal, or integration-heavy system built with long-term maintainability in mind.",
  },
  {
    label: "Agencies & studios",
    body: "You need a trusted technical partner to implement complex websites, apps, CMS setups, or backend systems without building a full internal dev team.",
  },
];

const process = [
  {
    step: "01",
    title: "Review",
    body: "We assess the product, codebase, stack, goals, and constraints.",
  },
  {
    step: "02",
    title: "Identify risk",
    body: "We find the architectural, technical, and operational blockers standing between the current state and a reliable launch.",
  },
  {
    step: "03",
    title: "Build the right foundation",
    body: "We improve structure, code quality, integrations, deployment setup, and scalability where it matters most.",
  },
  {
    step: "04",
    title: "Ship with confidence",
    body: "The result is a system that is more stable, maintainable, and ready for real usage.",
  },
];

const techGroups = [
  {
    category: "Frontend & frameworks",
    techs: ["TypeScript", "Next.js", "Astro", "React", "WordPress", "HubSpot"],
  },
  {
    category: "Backend & APIs",
    techs: ["Node.js", "TypeScript", "Python", "REST APIs", "Integrations"],
  },
  {
    category: "Databases",
    techs: ["PostgreSQL", "MongoDB", "MySQL"],
  },
  {
    category: "Infrastructure & deployment",
    techs: [
      "Docker",
      "Kubernetes",
      "GitHub",
      "CI/CD",
      "AWS",
      "GCP",
      "Vercel",
      "Cloudflare",
      "Netlify",
    ],
  },
];

const faqs = [
  {
    q: "Do you work with AI-generated prototypes?",
    a: "Yes. That is one of the core use cases. M/E Foundry helps review, restructure, and harden prototypes built with AI coding tools and fast-moving workflows so they can become reliable production systems.",
  },
  {
    q: "Do you only work on new builds?",
    a: "No. M/E Foundry also works on existing codebases, migrations, refactors, performance improvements, deployment setup, and rescue work for projects that need to be stabilized.",
  },
  {
    q: "Do you work with agencies?",
    a: "Yes. M/E Foundry partners with agencies and studios that need senior technical implementation, platform work, or backend development behind the scenes.",
  },
  {
    q: "Are you a freelancer or an agency?",
    a: "The model is founder-led and intentionally lean. Clients work directly with me, the founder, but the positioning and delivery are closer to a focused engineering studio than a generic freelance service.",
  },
  {
    q: "What kinds of projects do you take on?",
    a: "Scalable websites, content platforms, customer portals, backend systems, APIs, integrations, launch hardening, migrations, and prototype-to-production work.",
  },
  {
    q: "Can you help with deployment and infrastructure?",
    a: "Yes. That includes repositories, CI/CD, Docker, cloud deployment, environments, and production launch setup.",
  },
];

const problemQuestions = [
  "Can this architecture scale?",
  "Is the code maintainable?",
  "Is the stack right for the business?",
  "Is it secure enough to launch?",
  "Will performance, SEO, and infrastructure hold up under real usage?",
  "Can this become a real product, or does it need to be rebuilt?",
];
---

<MainLayout
  title="M/E Foundry — From Prototype to Production"
  description="Founder-led engineering studio helping businesses and agencies turn prototypes, AI-generated code, and early-stage products into production-ready websites, web apps, platforms, and APIs."
>
  <!-- HERO -->
  <div class="hero">
    <section class="max-w-6xl mx-auto px-4 md:px-6 py-24 md:py-36">
      <div class="max-w-3xl">
        <p
          class="text-xs font-semibold text-primary uppercase tracking-widest mb-5"
        >
          M/E Foundry
        </p>
        <h1 class="text-5xl md:text-7xl font-bold tracking-tight leading-[1.05]">
          From prototype<br />to production
        </h1>
        <p
          class="mt-7 text-xl md:text-2xl text-muted-foreground leading-relaxed max-w-2xl"
        >
          Founder-led engineering studio helping businesses and agencies turn
          prototypes, AI-generated code, and early-stage products into
          production-ready websites, web apps, platforms, and APIs.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row gap-3">
          <a
            onclick="Calendly.initPopupWidget({url: 'https://calendly.com/milukove/discovery-call'});return false;"
            href="/"
            class="cursor-pointer inline-flex items-center justify-center px-6 py-3 rounded-lg bg-primary text-primary-foreground font-medium hover:opacity-90 transition-opacity"
          >
            Book a discovery call
          </a>
          <a
            href="https://tally.so/r/eqLg7x"
            target="_blank"
            class="inline-flex items-center justify-center px-6 py-3 rounded-lg border border-border font-medium hover:bg-accent hover:text-accent-foreground transition-colors"
          >
            Get a technical review
          </a>
        </div>
      </div>
    </section>
  </div>

  <!-- POSITIONING STRIP -->
  <section class="border-y border-border bg-muted/30">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-8">
      <p class="text-sm text-muted-foreground mb-5">
        Direct senior engineering across product architecture, frontend,
        backend, CMS platforms, APIs, infrastructure, deployment, and launch
        readiness.
      </p>
      <TechLogos />
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="bg-card border-b border-border">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-20 md:py-28">
      <div class="max-w-3xl">
        <h2 class="text-3xl md:text-4xl font-bold">
          The prototype works. But can it survive production?
        </h2>
        <div class="mt-8 space-y-4 text-muted-foreground">
          <p>
            Today, almost anyone can build a convincing prototype with AI coding
            tools and fast-moving workflows. That is no longer the hard part.
          </p>
          <p>
            The real challenge begins when a product needs to be launched
            properly.
          </p>
          <p>That is when teams start asking the harder questions:</p>
        </div>
        <ul class="mt-6 space-y-3">
          {
            problemQuestions.map((q) => (
              <li class="flex items-start gap-3">
                <span class="text-primary font-bold mt-0.5 shrink-0">→</span>
                <span class="font-medium">{q}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-8 text-muted-foreground">
          Many teams reach this stage with momentum, but without confidence.
          That is where M/E Foundry comes in.
        </p>
      </div>
    </div>
  </section>

  <!-- SOLUTION -->
  <section class="max-w-6xl mx-auto px-4 md:px-6 py-20 md:py-28">
    <div class="max-w-3xl">
      <h2 class="text-3xl md:text-4xl font-bold">
        M/E Foundry helps teams close the gap between demo and deployment
      </h2>
      <div class="mt-6 space-y-4 text-muted-foreground text-lg leading-relaxed">
        <p>
          M/E Foundry works with founders, businesses, and agencies that already
          have something in motion: a prototype, an MVP, a rushed codebase, a
          half-built platform, or a website that needs serious technical work
          before launch.
        </p>
        <p>Our role is to turn that into a production-ready system.</p>
        <p>
          That can include architecture review, refactoring, backend work,
          integrations, database design, SEO and performance improvements, CI/CD
          setup, infrastructure planning, deployment workflows, and launch
          support.
        </p>
      </div>
      <blockquote
        class="mt-8 border-l-2 border-primary pl-5 text-foreground font-medium"
      >
        You work directly with the engineer doing the work. No handoffs. No PM
        layers. No bloated agency process. Just focused on technical execution.
      </blockquote>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="border-t border-border bg-muted/20">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-20 md:py-28">
      <h2 class="text-3xl md:text-4xl font-bold mb-12">
        What M/E Foundry helps with
      </h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          services.map((service) => (
            <div class="bg-card border border-border rounded-xl p-6 flex flex-col">
              <span class="text-xs font-mono text-primary mb-4">
                {service.num}
              </span>
              <h3 class="font-semibold text-lg mb-3">{service.title}</h3>
              <p class="text-muted-foreground text-sm leading-relaxed flex-1">
                {service.body}
              </p>
            </div>
          ))
        }
      </div>
      <div class="mt-10">
        <a
          href="https://tally.so/r/eqLg7x"
          target="_blank"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg border border-border text-sm font-medium hover:bg-accent hover:text-accent-foreground transition-colors"
        >
          Discuss your project →
        </a>
      </div>
    </div>
  </section>

  <!-- WHY THIS MODEL WORKS -->
  <section class="border-t border-border">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-20 md:py-28">
      <div class="max-w-2xl mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">
          A leaner model. A more direct way to ship.
        </h2>
        <p class="text-muted-foreground">
          Traditional agencies often add layers between the problem and the
          solution: account managers, project managers, long handoffs, and
          unclear ownership. This model is intentionally different.
        </p>
        <p class="mt-3 text-muted-foreground">
          This is a founder-led, AI-native engineering studio built for speed,
          clarity, and direct execution. M/E Foundry uses custom AI agents to
          accelerate analysis, implementation, and delivery, but technical
          decisions are guided by real engineering experience.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-10">
        {
          valuePoints.map((point) => (
            <div>
              <div class="w-8 h-0.5 bg-primary rounded mb-5" />
              <h3 class="font-semibold text-lg mb-2">{point.title}</h3>
              <p class="text-muted-foreground text-sm leading-relaxed">
                {point.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SELECTED WORK -->
  <section id="work" class="border-t border-border bg-muted/20">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-20 md:py-28">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Selected work</h2>
      <p class="text-muted-foreground max-w-2xl mb-12">
        M/E Foundry works across product engineering, content platforms,
        integrations, infrastructure, and production hardening. Projects range
        from high-performance websites and CMS implementations to scalable web
        apps, API backends, and launch systems.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-card border border-border rounded-xl p-8">
          <p
            class="text-xs font-semibold text-primary uppercase tracking-widest mb-3"
          >
            Confidential — SaaS Platform
          </p>
          <h3 class="font-semibold text-xl mb-6">
            Prototype rescue & production launch
          </h3>
          <div class="space-y-5 text-sm">
            <div>
              <p class="font-medium text-foreground mb-1">Challenge</p>
              <p class="text-muted-foreground">
                AI-generated MVP with mounting technical debt, no deployment
                pipeline, and architectural fragility blocking a planned
                production launch.
              </p>
            </div>
            <div>
              <p class="font-medium text-foreground mb-1">
                What M/E Foundry handled
              </p>
              <p class="text-muted-foreground">
                Full codebase audit, architecture refactoring, CI/CD pipeline
                setup, database schema optimisation, and cloud infrastructure
                configuration.
              </p>
            </div>
            <div>
              <p class="font-medium text-foreground mb-1">Outcome</p>
              <p class="text-muted-foreground">
                Production launch completed. Codebase made maintainable.
                Deployment process automated end-to-end.
              </p>
            </div>
          </div>
        </div>
        <div class="bg-card border border-border rounded-xl p-8">
          <p
            class="text-xs font-semibold text-primary uppercase tracking-widest mb-3"
          >
            Agency Partnership — CMS Build
          </p>
          <h3 class="font-semibold text-xl mb-6">
            High-performance content platform
          </h3>
          <div class="space-y-5 text-sm">
            <div>
              <p class="font-medium text-foreground mb-1">Challenge</p>
              <p class="text-muted-foreground">
                Design agency needed a senior implementation partner for a
                complex, performance-critical content platform without expanding
                their internal team.
              </p>
            </div>
            <div>
              <p class="font-medium text-foreground mb-1">
                What M/E Foundry handled
              </p>
              <p class="text-muted-foreground">
                Full technical implementation in Next.js with headless CMS
                integration, SEO architecture, performance optimisation, and
                Vercel deployment.
              </p>
            </div>
            <div>
              <p class="font-medium text-foreground mb-1">Outcome</p>
              <p class="text-muted-foreground">
                On-time delivery. Strong Core Web Vitals scores. Ongoing
                technical partnership established.
              </p>
            </div>
          </div>
        </div>
      </div>
      <div class="mt-10">
        <a
          href="https://tally.so/r/eqLg7x"
          target="_blank"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg border border-border text-sm font-medium hover:bg-accent hover:text-accent-foreground transition-colors"
        >
          Discuss your project →
        </a>
      </div>
    </div>
  </section>

  <!-- AUDIENCE -->
  <section class="border-t border-border">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-20 md:py-28">
      <h2 class="text-3xl md:text-4xl font-bold mb-12">
        Who M/E Foundry works with
      </h2>
      <div class="grid md:grid-cols-3 gap-6">
        {
          audience.map((a) => (
            <div class="bg-card border border-border rounded-xl p-6">
              <h3 class="font-semibold text-lg mb-3">{a.label}</h3>
              <p class="text-muted-foreground text-sm leading-relaxed">
                {a.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="border-t border-border bg-muted/20">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-20 md:py-28">
      <h2 class="text-3xl md:text-4xl font-bold mb-12">
        How M/E Foundry works
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10">
        {
          process.map((s) => (
            <div>
              <span class="text-5xl font-bold text-primary/20 leading-none">
                {s.step}
              </span>
              <h3 class="font-semibold text-lg mt-4 mb-2">{s.title}</h3>
              <p class="text-muted-foreground text-sm leading-relaxed">
                {s.body}
              </p>
            </div>
          ))
        }
      </div>
      <p
        class="mt-12 text-sm text-muted-foreground max-w-xl border-l border-border pl-5"
      >
        Every project is different, but the goal is consistent: reduce risk,
        improve clarity, and get the product into a launch-ready state.
      </p>
    </div>
  </section>

  <!-- TECHNOLOGY -->
  <section class="border-t border-border">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-20 md:py-28">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Technology breadth</h2>
      <p class="text-muted-foreground max-w-2xl mb-12">
        M/E Foundry works across modern web stacks and chooses technology based
        on the product, the team, and the long-term fit — not on trend alone.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10">
        {
          techGroups.map((group) => (
            <div>
              <p class="text-xs font-semibold text-muted-foreground uppercase tracking-widest mb-4">
                {group.category}
              </p>
              <div class="flex flex-wrap gap-2">
                {group.techs.map((tech) => (
                  <span class="bg-muted text-foreground text-xs px-3 py-1 rounded-full">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="border-t border-border bg-muted/20">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-20 md:py-28">
      <div class="grid md:grid-cols-[1fr_200px] gap-16 items-start max-w-4xl">
        <div>
          <p
            class="text-xs font-semibold text-primary uppercase tracking-widest mb-4"
          >
            About
          </p>
          <h2 class="text-3xl md:text-4xl font-bold mb-6">
            Founder-led. Technical. Focused on shipping.
          </h2>
          <div class="space-y-4 text-muted-foreground leading-relaxed">
            <p>
              I'm Egor Miliukov, founder and senior full-stack engineer helping
              businesses and agencies turn prototypes into production-ready
              systems.
            </p>
            <p>
              My work spans websites, web apps, platforms, APIs, infrastructure,
              and launch workflows. I combine hands-on engineering experience
              with custom AI agents to move faster without compromising
              production quality.
            </p>
            <p>
              Clients work directly with me on architecture, implementation, and
              launch readiness — without the overhead of a traditional agency.
            </p>
          </div>
          <div class="mt-8">
            <a
              href="https://tally.so/r/eqLg7x"
              target="_blank"
              class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg border border-border text-sm font-medium hover:bg-accent hover:text-accent-foreground transition-colors"
            >
              Discuss your project →
            </a>
          </div>
        </div>
        <div class="hidden md:block">
          <img
            src="/profile.jpeg"
            alt="Egor Miliukov"
            class="rounded-2xl w-48 h-48 object-cover"
            width={192}
            height={192}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="border-t border-border">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-20 md:py-28">
      <h2 class="text-3xl md:text-4xl text-center font-bold mb-12">
        Frequently asked questions
      </h2>
      <div class="max-w-3xl divide-y divide-border mx-auto">
        {
          faqs.map((faq) => (
            <details class="group py-5">
              <summary class="flex items-center justify-between cursor-pointer list-none gap-4 text-left">
                <span class="font-medium">{faq.q}</span>
                <span class="shrink-0 text-muted-foreground text-xl leading-none group-open:rotate-45 transition-transform duration-200">
                  +
                </span>
              </summary>
              <p class="mt-4 text-muted-foreground text-sm leading-relaxed text-left">
                {faq.a}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section id="contact" class="border-t border-border bg-card">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-24 md:py-32 text-center">
      <h2
        class="text-3xl md:text-5xl font-bold max-w-2xl mx-auto leading-tight"
      >
        Need help turning a prototype into a real product?
      </h2>
      <p class="mt-6 text-muted-foreground max-w-xl mx-auto leading-relaxed">
        If you have an MVP, prototype, messy codebase, or platform idea that
        needs serious technical work before launch, M/E Foundry can help assess
        the risks, improve the foundation, and move it toward production.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-3 justify-center">
        <a
          onclick="Calendly.initPopupWidget({url: 'https://calendly.com/milukove/discovery-call'});return false;"
          href="/"
          class="cursor-pointer inline-flex items-center justify-center px-8 py-4 rounded-lg bg-primary text-primary-foreground font-medium hover:opacity-90 transition-opacity text-base"
        >
          Book a discovery call
        </a>
        <a
          href="https://tally.so/r/eqLg7x"
          target="_blank"
          class="inline-flex items-center justify-center px-8 py-4 rounded-lg border border-border font-medium hover:bg-accent hover:text-accent-foreground transition-colors text-base"
        >
          Start with a technical review
        </a>
      </div>
    </div>
  </section>
</MainLayout>
